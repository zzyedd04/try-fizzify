APP_NAME=Fizzify
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://fizzify-laravel.test
APP_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------- Database (MySQL Laragon) ----------
# Laragon: MySQL jalan di 127.0.0.1:3306, user "root", password kosong.
# Database "fizzify" dibuat otomatis oleh: php artisan fizzify:install
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fizzify
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ---------- Midtrans (Sandbox) ----------
# Ambil di https://dashboard.sandbox.midtrans.com -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Kalau muncul error "cURL error 60: SSL certificate problem" di Windows/Laragon, set false (HANYA untuk lokal)
MIDTRANS_VERIFY_SSL=true

# ---------- Login Google ----------
# Buat di https://console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web)
# Authorized redirect URI: samakan dengan GOOGLE_REDIRECT_URI di bawah
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://fizzify-laravel.test/auth/google/callback

# ---------- Fizzify ----------
# Nomor WhatsApp tujuan form Contact (tanpa tanda +, diawali 62)
FIZZIFY_WHATSAPP=6286582391224
FIZZIFY_WHATSAPP_DISPLAY="(+62) 865 8239 1224"
FIZZIFY_EMAIL=fizzify@gmail.com
FIZZIFY_ACCOUNT_NUMBER=70620043067
# Email Google yang boleh login sebagai admin lewat tombol Google (pisahkan dengan koma)
ADMIN_EMAILS=
